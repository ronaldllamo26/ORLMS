        </mxCell>
        <mxCell id="s7" value="🤖 AI Similarity Check:&lt;br&gt;&lt;i&gt;Cross-reference against ALL existing&lt;br&gt;ordinances &amp;amp; resolutions in database&lt;/i&gt;&lt;br&gt;→ Returns &lt;b&gt;similarity_score&lt;/b&gt; &amp;amp; &lt;b&gt;similar_document_id&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=10;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
