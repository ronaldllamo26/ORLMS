          <mxGeometry x="200" y="300" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Send document content to&lt;br&gt;&lt;b&gt;Groq Cloud API&lt;/b&gt; (Llama LLM)&lt;br&gt;&lt;i&gt;via HTTPS request&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=11;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
