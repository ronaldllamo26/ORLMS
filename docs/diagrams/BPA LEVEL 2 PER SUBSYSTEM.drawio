        <mxCell id="s3" value="Click &#39;Run AI Validation&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a5f;fontSize=11;fontFamily=Segoe UI;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="230" width="240" height="40" as="geometry" />
