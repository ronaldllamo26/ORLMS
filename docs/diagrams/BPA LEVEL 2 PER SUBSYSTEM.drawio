        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;BPA Level 2 — AI Validation Engine Subsystem&lt;/b&gt;&lt;br&gt;Actor: Legislative Staff | System: Groq Cloud API (Llama LLM)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Segoe UI;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="650" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;START&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#22c55e;strokeColor=#16a34a;fontColor=#fff;fontSize=12;fontFamily=Segoe UI;fontStyle=1;shadow=1;" vertex="1" parent="1">
