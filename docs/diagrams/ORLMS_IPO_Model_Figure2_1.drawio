<mxfile host="app.diagrams.net" modified="2026-08-02T13:20:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="ipo_model" name="Figure 2.1 IPO Model">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Figure 2.1 Input-Process-Output (IPO) Model with Agile Feedback Mechanism&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontFamily=Segoe UI;fontColor=#1e3a5f;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="580" height="40" as="geometry" />
        </mxCell>

        <!-- INPUT Box -->
        <mxCell id="input" value="&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;• Legislative Data (Ordinance &amp;amp; Resolution drafts, Document templates)&lt;br&gt;• User Profiles &amp;amp; Roles (Admin, Secretariat, Committee Chairs, Council Members)&lt;br&gt;• Historical City Legislation (Archived ordinances &amp;amp; resolutions corpus)&lt;br&gt;• System Infrastructure (PHP MVC, Supabase PostgreSQL, HostForge Cloud, Groq API)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;fontSize=12;fontFamily=Segoe UI;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="150" y="80" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- PROCESS Box -->
        <mxCell id="process" value="&lt;b&gt;PROCESS&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. System Development Life Cycle (SDLC)&lt;/b&gt;&lt;br&gt;  • Requirements Analysis, PostgreSQL Database Design, UI/UX&lt;br&gt;  • Development, HostForge Deployment, &amp;amp; ISO/IEC 25010 Evaluation&lt;br&gt;&lt;b&gt;2. System Module Executions &amp;amp; Legislative Processing&lt;/b&gt;&lt;br&gt;  • RBAC Security, Digital Registry, &amp;amp; Audit Logging&lt;br&gt;  • Committee Routing, Plenary Session Voting Tally, &amp;amp; LCE Approval Router&lt;br&gt;  • Public Portal &amp;amp; Citizen Registry&lt;br&gt;&lt;b&gt;3. Intelligent AI-Assisted Validation Engine&lt;/b&gt;&lt;br&gt;  • Automated Structural Completeness Check (Groq Cloud API)&lt;br&gt;  • Semantic Similarity &amp;amp; Redundancy Checking&lt;br&gt;  • Plain-Language Summary Generation (Llama LLM)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;fontSize=12;fontFamily=Segoe UI;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="150" y="210" width="480" height="210" as="geometry" />
        </mxCell>

        <!-- OUTPUT Box -->
        <mxCell id="output" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;• Ordinance &amp;amp; Resolution Lifecycle Management System (ORLMS)&lt;br&gt;• AI-Driven Legislative Validation Reports (Completeness &amp;amp; Similarity reports)&lt;br&gt;• Citizen Public Registry Portal &amp;amp; AI Plain-Language Summaries&lt;br&gt;• Improved Governance Outcomes (Reduced policy redundancy, transparency, secure audit trails)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;fontSize=12;fontFamily=Segoe UI;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="150" y="460" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- Arrow: Input -> Process -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#374151;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="input" target="process" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Process -> Output -->
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#374151;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="process" target="output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Feedback Loop Connector (U-Turn Arrow) -->
        <mxCell id="feedback_arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e3a8a;strokeWidth=4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;curved=1;" edge="1" source="output" target="process" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="505" />
              <mxPoint x="690" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Feedback Loop Text Label -->
        <mxCell id="feedback_label" value="&lt;b&gt;FEEDBACK LOOP&lt;/b&gt;&lt;br&gt;• Sprint Reviews&lt;br&gt;• Sprint Retrospectives&lt;br&gt;• UAT &amp;amp; ISO 25010" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Segoe UI;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="710" y="275" width="130" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
